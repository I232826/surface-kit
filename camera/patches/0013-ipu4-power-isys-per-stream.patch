-static int video_release(struct file *file)
+void ipu_isys_video_power_put(struct ipu_isys_video *av)
+{
+	struct ipu_isys *isys = av->isys;
+	bool reset_needed;
+
+	mutex_lock(&isys->mutex);
+
+	if (!--isys->video_opened) {
+		ipu_fw_isys_close(isys);
+		if (isys->fwcom)
+			isys->reset_needed = true;
+	}
+	reset_needed = isys->reset_needed;
+
+	mutex_unlock(&isys->mutex);
+
+	/*
+	 * After a failure suspend right away, so the next stream starts on a
+	 * freshly powered isys with the latch cleared.
+	 */
+	if (reset_needed)
+		pm_runtime_put_sync(&isys->adev->dev);
+	else
+		pm_runtime_put(&isys->adev->dev);
+}
+
+static int video_open(struct file *file)
 {
 	struct ipu_isys_video *av = video_drvdata(file);
-	int ret = 0;
+	int rval;
 
-	vb2_fop_release(file);
+	rval = v4l2_fh_open(file);
+	if (rval)
+		return rval;
 
-	mutex_lock(&av->isys->mutex);
+	/* No sub-device here implements s_power; kept for the use counts. */
+	rval = v4l2_pipeline_pm_get(&av->vdev.entity);
+	if (rval)
+		v4l2_fh_release(file);
 
-	if (!--av->isys->video_opened) {
-		ipu_fw_isys_close(av->isys);
-		if (av->isys->fwcom) {
-			av->isys->reset_needed = true;
-			ret = -EIO;
-		}
-	}
+	return rval;
+}
 
-	mutex_unlock(&av->isys->mutex);
+static int video_release(struct file *file)
+{
+	struct ipu_isys_video *av = video_drvdata(file);
 
-    v4l2_pipeline_pm_put(&av->vdev.entity);
+	/* Stops streaming on this queue if it was, which drops its power. */
+	vb2_fop_release(file);
 
-	if (av->isys->reset_needed)
-		pm_runtime_put_sync(&av->isys->adev->dev);
-	else
-		pm_runtime_put(&av->isys->adev->dev);
+	v4l2_pipeline_pm_put(&av->vdev.entity);
 
-	return ret;
+	return 0;
 }
 
