From: surface-kit
Subject: [PATCH] media: i2c: ov5693: add a mirror module parameter

Front-facing cameras usually feel natural mirrored, but libcamera always
asks for the un-mirrored orientation. mirror=1 inverts the HFLIP control
in the driver. (That the bus code stays the same was wrong: see 0005.)

---
--- a/ov5693.c
+++ b/ov5693.c
@@ -393,6 +393,15 @@
 
 /* V4L2 Controls Functions */
 
+/*
+ * Surface Pro 7 front camera: mirror the image (selfie view) by inverting
+ * whatever horizontal flip user space asks for. Both the sensor and the ISP
+ * flip bits are toggled, so the Bayer order stays SBGGR either way.
+ */
+static bool mirror;
+module_param(mirror, bool, 0644);
+MODULE_PARM_DESC(mirror, "Invert horizontal flip (mirrored selfie view)");
+
 static int ov5693_flip_vert_configure(struct ov5693_device *ov5693,
 				      bool enable)
 {
@@ -546,7 +555,7 @@
 		ret = ov5693_digital_gain_configure(ov5693, ctrl->val);
 		break;
 	case V4L2_CID_HFLIP:
-		ret = ov5693_flip_horz_configure(ov5693, !!ctrl->val);
+		ret = ov5693_flip_horz_configure(ov5693, !!ctrl->val ^ mirror);
 		break;
 	case V4L2_CID_VFLIP:
 		ret = ov5693_flip_vert_configure(ov5693, !!ctrl->val);
