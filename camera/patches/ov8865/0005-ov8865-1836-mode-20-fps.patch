ov8865: 3264x1836 at 20 fps instead of 15 (blanking of the full mode)

--- a/ov8865.c
+++ b/ov8865.c
@@ -1019,7 +1019,12 @@
 
 		/* Vertical */
 		.output_size_y			= 1836,
