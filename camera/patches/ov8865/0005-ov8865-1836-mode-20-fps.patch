+		/*
+		 * 2470 is the 3264x2448 mode's frame length: 634 idle lines,
+		 * 15 fps. 1862 keeps the same line rate (and link load) with
+		 * the blanking of the full mode: 19.9 fps.
+		 */
+		.vts				= 1862,
 
 		.size_auto			= true,
 		.size_auto_boundary_x		= 8,
