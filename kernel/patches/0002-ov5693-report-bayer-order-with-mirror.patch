diff --git a/drivers/media/i2c/ov5693.c b/drivers/media/i2c/ov5693.c
index 755d570c1..90bf4e22a 100644
--- a/drivers/media/i2c/ov5693.c
+++ b/drivers/media/i2c/ov5693.c
@@ -363,13 +363,20 @@ static const u8 ov5693_test_pattern_bits[] = {
 
 /*
  * Surface Pro 7 front camera: mirror the image (selfie view) by inverting
- * whatever horizontal flip user space asks for. Both the sensor and the ISP
- * flip bits are toggled, so the Bayer order stays SBGGR either way.
+ * whatever horizontal flip user space asks for. The Bayer order follows the
+ * flip: libcamera always asks for the flip on (the sensor is mounted rotated),
+ * which mirror=1 turns off, and the sensor then reads out GBRG rather than
+ * BGGR (measured on raw frames from the Surface Pro 7). Report that.
  */
 static bool mirror;
-module_param(mirror, bool, 0644);
+module_param(mirror, bool, 0444);
 MODULE_PARM_DESC(mirror, "Invert horizontal flip (mirrored selfie view)");
 
+static u32 ov5693_mbus_code(void)
+{
+	return mirror ? MEDIA_BUS_FMT_SGBRG10_1X10 : MEDIA_BUS_FMT_SBGGR10_1X10;
+}
+
 static int ov5693_flip_vert_configure(struct ov5693_device *ov5693,
 				      bool enable)
 {
@@ -874,7 +881,7 @@ static int ov5693_set_fmt(struct v4l2_subdev *sd,
 
 	fmt->width = crop->width / hratio;
 	fmt->height = crop->height / vratio;
-	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->code = ov5693_mbus_code();
 
 	format->format = *fmt;
 
@@ -1064,7 +1071,7 @@ static int ov5693_enum_mbus_code(struct v4l2_subdev *sd,
 	if (code->index > 0)
 		return -EINVAL;
 
-	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	code->code = ov5693_mbus_code();
 	return 0;
 }
 
@@ -1075,7 +1082,7 @@ static int ov5693_enum_frame_size(struct v4l2_subdev *sd,
 	struct ov5693_device *ov5693 = to_ov5693_sensor(sd);
 	struct v4l2_rect *__crop;
 
-	if (fse->index > 1 || fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+	if (fse->index > 1 || fse->code != ov5693_mbus_code())
 		return -EINVAL;
 
 	__crop = __ov5693_get_pad_crop(ov5693, state, fse->pad, fse->which);
@@ -1351,6 +1358,7 @@ static int ov5693_probe(struct i2c_client *client)
 
 	ov5693->mode.crop = ov5693_default_crop;
 	ov5693->mode.format = ov5693_default_fmt;
+	ov5693->mode.format.code = ov5693_mbus_code();
 	ov5693->mode.vts = __ov5693_calc_vts(ov5693->mode.format.height);
 
 	ret = ov5693_init_controls(ov5693);
