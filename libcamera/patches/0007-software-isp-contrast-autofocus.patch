+/*
+ * Focus measure for unpacked formats (x counts pixels): green contrast
+ * between neighbouring sampled cells, 4 pixels apart, inside the centre
+ * third. Packed formats don't gather it and report afLevel 0.
+ */
+#define SWSTATS_START_AF_STATS() \
+	uint64_t afContrast = 0;     \
+	uint64_t afLevel = 0;        \
+	int gPrev = -1;
+
+#define SWSTATS_ACCUMULATE_AF_STATS()                              \
+	if (afLine_ && x >= afX0_ && x < afX1_) {                  \
+		if (gPrev >= 0)                                     \
+			afContrast += std::abs(static_cast<int>(g) - gPrev); \
+		afLevel += g;                                       \
+		gPrev = g;                                          \
+	}
+
+#define SWSTATS_FINISH_AF_STATS()          \
+	stats_.afContrast += afContrast;   \
+	stats_.afLevel += afLevel;
