+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detection autofocus for the soft IPA
+ */
+
+#pragma once
+
+#include <deque>
+#include <vector>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const YamlObject &tuningData) override;
+	int configure(IPAContext &context,
+		      const IPAConfigInfo &configInfo) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class State {
+		Startup,	/* waiting for the exposure to settle */
+		Scan,		/* sweeping the lens */
+		Final,		/* moved to the peak, waiting to measure it */
+		Locked,		/* in focus, watching for scene changes */
+		Changed,	/* scene changed, waiting for it to settle */
+	};
+
+	struct Move {
+		int32_t position;
+		uint32_t effective;	/* first frame fully showing it */
+	};
+
+	void move(IPAContext &context, uint32_t frame, int32_t position);
+	bool sampleFor(uint32_t frame, int32_t *position) const;
+	void startScan(IPAContext &context, uint32_t frame);
+	int32_t peak() const;
+	void lock(double score, double level);
+
+	/* Tuning */
+	int32_t step_;
+	int32_t scanMax_;
+	uint32_t settleFrames_;
+	uint32_t startupFrames_;
+	double changeThreshold_;
+
+	State state_;
+	uint32_t startFrame_;
+	int32_t nextPosition_;
+	std::deque<Move> moves_;
+	std::vector<std::pair<int32_t, double>> samples_;
+	double bestScore_;
+	unsigned int pastPeak_;
+
+	double lockedScore_;
+	double lockedLevel_;
+	double lastScore_;
+	double lastLevel_;
+	unsigned int changedCount_;
+	unsigned int stableCount_;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
