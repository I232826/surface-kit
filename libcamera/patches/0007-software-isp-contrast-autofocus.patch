+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detection autofocus for the soft IPA
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/yaml_parser.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+/**
+ * \class Af
+ * \brief Contrast detection autofocus driving the sensor's VCM lens
+ *
+ * The focus measure is the green contrast in the centre of the image from
+ * the software ISP statistics, divided by the green level so it doesn't
+ * follow the exposure. Statistics arrive every few frames and a lens move
+ * shows in the frames a few frames later, so moves are tagged with the
+ * first frame expected to show them and each measurement is credited to the
+ * move in effect for its frame. That lets the sweep move the lens once per
+ * statistics frame instead of waiting for every move to show.
+ *
+ * Sweep from far (0) to near in coarse steps, stop once the measure has
+ * clearly passed a peak, and move to the peak refined by fitting a Gaussian
+ * through it and its neighbours. Then hold, and sweep again when the scene
+ * has changed and come to rest.
+ */
+
+int Af::init([[maybe_unused]] IPAContext &context, const YamlObject &tuningData)
+{
+	step_ = tuningData["step"].get<int32_t>(64);
+	scanMax_ = tuningData["scanMax"].get<int32_t>(768);
+	settleFrames_ = tuningData["settleFrames"].get<uint32_t>(5);
+	startupFrames_ = tuningData["startupFrames"].get<uint32_t>(36);
+	changeThreshold_ = tuningData["changeThreshold"].get<double>(0.35);
+
+	if (step_ <= 0)
+		step_ = 64;
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context,
+		  [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	state_ = State::Startup;
+	startFrame_ = 0;
+	moves_.clear();
+	samples_.clear();
+	changedCount_ = 0;
+	stableCount_ = 0;
+	context.activeState.af.changed = false;
+
+	LOG(IPASoftAf, Debug)
+		<< "Lens range " << context.configuration.af.lensMin
+		<< "-" << context.configuration.af.lensMax;
+
+	return 0;
+}
+
+void Af::move(IPAContext &context, uint32_t frame, int32_t position)
+{
+	const auto &cfg = context.configuration.af;
+	position = std::clamp(position, cfg.lensMin, cfg.lensMax);
+
+	context.activeState.af.position = position;
+	context.activeState.af.changed = true;
+
+	moves_.push_back({ position, frame + settleFrames_ });
+	while (moves_.size() > 16)
+		moves_.pop_front();
+}
+
+/*
+ * Find the move a measurement of \a frame belongs to: the latest one already
+ * in effect, and only if the next one isn't. False while the frame still
+ * predates every recorded move.
+ */
+bool Af::sampleFor(uint32_t frame, int32_t *position) const
+{
+	for (auto it = moves_.rbegin(); it != moves_.rend(); ++it) {
+		if (it->effective <= frame) {
+			*position = it->position;
+			return true;
+		}
+	}
+	return false;
+}
+
+void Af::startScan(IPAContext &context, uint32_t frame)
+{
+	state_ = State::Scan;
+	samples_.clear();
+	moves_.clear();
+	bestScore_ = 0.0;
+	pastPeak_ = 0;
+	nextPosition_ = context.configuration.af.lensMin;
+
+	LOG(IPASoftAf, Debug) << "Scan from " << nextPosition_;
+
+	move(context, frame, nextPosition_);
+	nextPosition_ += step_;
+}
+
+int32_t Af::peak() const
+{
+	auto best = std::max_element(samples_.begin(), samples_.end(),
+				     [](const auto &a, const auto &b) {
+					     return a.second < b.second;
+				     });
+	if (best == samples_.end())
+		return 0;
+
+	const int32_t position = best->first;
+	if (best == samples_.begin() || best + 1 == samples_.end())
+		return position;
+
+	/* Gaussian through the peak and its neighbours: fit a parabola in log */
+	const double l0 = std::log(std::max((best - 1)->second, 1e-9));
+	const double l1 = std::log(std::max(best->second, 1e-9));
+	const double l2 = std::log(std::max((best + 1)->second, 1e-9));
+	const double denom = l0 - 2.0 * l1 + l2;
+	if (denom >= 0.0)
+		return position;
+
+	const double offset = std::clamp(0.5 * (l0 - l2) / denom, -0.5, 0.5);
+	return position + static_cast<int32_t>(std::lround(offset * step_));
+}
+
+void Af::lock(double score, double level)
+{
+	state_ = State::Locked;
+	lockedScore_ = score;
+	lockedLevel_ = level;
+	changedCount_ = 0;
+}
+
+void Af::process(IPAContext &context, const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 [[maybe_unused]] ControlList &metadata)
+{
+	const auto &cfg = context.configuration.af;
+	if (cfg.lensMax <= cfg.lensMin || !stats->valid || !stats->afLevel)
+		return;
+
+	const double level = static_cast<double>(stats->afLevel);
+	const double score = stats->afContrast / level;
+
+	switch (state_) {
+	case State::Startup:
+		if (!startFrame_)
+			startFrame_ = frame ? frame : 1;
+		if (frame - startFrame_ >= startupFrames_)
+			startScan(context, frame);
+		break;
+
+	case State::Scan: {
+		int32_t position;
+		if (sampleFor(frame, &position) &&
+		    (samples_.empty() || samples_.back().first != position)) {
+			samples_.push_back({ position, score });
+			LOG(IPASoftAf, Debug)
+				<< "Scan " << position << ": " << score;
+
+			if (score > bestScore_) {
+				bestScore_ = score;
+				pastPeak_ = 0;
+			} else if (score < 0.75 * bestScore_) {
+				pastPeak_++;
+			}
+		}
+
+		const bool done = pastPeak_ >= 2 ||
+				  (nextPosition_ > scanMax_ &&
+				   !samples_.empty() &&
+				   samples_.back().first == moves_.back().position);
+		if (done) {
+			const int32_t target = peak();
+			LOG(IPASoftAf, Debug) << "Peak at " << target;
+			moves_.clear();
+			move(context, frame, target);
+			state_ = State::Final;
+			break;
+		}
+
+		if (nextPosition_ <= scanMax_) {
+			move(context, frame, nextPosition_);
+			nextPosition_ += step_;
+		}
+		break;
+	}
+
+	case State::Final: {
+		int32_t position;
+		if (sampleFor(frame, &position) &&
+		    position == context.activeState.af.position)
+			lock(score, level);
+		break;
+	}
+
+	case State::Locked:
+		if (std::abs(score / lockedScore_ - 1.0) > changeThreshold_ ||
+		    std::abs(level / lockedLevel_ - 1.0) > changeThreshold_)
+			changedCount_++;
+		else
+			changedCount_ = 0;
+
+		if (changedCount_ >= 3) {
+			state_ = State::Changed;
+			stableCount_ = 0;
+		}
+		break;
+
+	case State::Changed:
+		/* Wait until the scene holds still before sweeping again */
+		if (std::abs(score / lastScore_ - 1.0) < 0.1 &&
+		    std::abs(level / lastLevel_ - 1.0) < 0.1)
+			stableCount_++;
+		else
+			stableCount_ = 0;
+
+		if (stableCount_ >= 2)
+			startScan(context, frame);
+		break;
+	}
+
+	lastScore_ = score;
+	lastLevel_ = level;
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
