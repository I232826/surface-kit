+/*
+ * Map a gained gamma table index through the highlight shoulder: identity
+ * below the knee (as a fraction of the range above black), then an
+ * exponential roll-off towards full scale, so highlights pushed past it by
+ * the colour gains keep some gradation instead of clipping flat.
+ */
+unsigned int DebayerCpu::shoulderIndex(float index, const DebayerParams &params) const
+{
+	static constexpr float kKnee = 0.75f;
+	const float size = gammaTable_.size();
+	const float black = params.blackLevel[1] * size;
+	const float range = size - 1.0f - black;
+	if (range <= 0.0f)
+		return std::clamp(index, 0.0f, size - 1.0f);
+
+	float x = (index - black) / range;
+	if (x > kKnee)
+		x = kKnee + (1.0f - kKnee) * (1.0f - std::exp(-(x - kKnee) / (1.0f - kKnee)));
+
+	return static_cast<unsigned int>(std::clamp(black + x * range, 0.0f, size - 1.0f));
+}
