+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Radial lens shading correction for the soft IPA
+ */
+
+#include "lsc.h"
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/yaml_parser.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftLsc)
+
+/**
+ * \class Lsc
+ * \brief Radial lens shading correction from tuning data
+ *
+ * The gain for each raw channel is 1 + k1 r^2 + k2 r^4, with r the distance
+ * from the image centre divided by half the image width, so one set of
+ * coefficients fits every mode that uses the sensor's full width, whether
+ * cropped or binned. The tuning file gives k1 and k2 as [ r, g, b ].
+ */
+
+static RGB<float> readRGB(const YamlObject &data, const char *key)
+{
+	RGB<float> v({ 0.0f, 0.0f, 0.0f });
+	const YamlObject &list = data[key];
+	if (list.isList() && list.size() == 3) {
+		for (unsigned int i = 0; i < 3; i++)
+			v[i] = list[i].get<float>(0.0f);
+	}
+	return v;
+}
+
+int Lsc::init([[maybe_unused]] IPAContext &context, const YamlObject &tuningData)
+{
+	k1_ = readRGB(tuningData, "k1");
+	k2_ = readRGB(tuningData, "k2");
+
+	LOG(IPASoftLsc, Debug) << "k1 " << k1_ << " k2 " << k2_;
+	return 0;
+}
+
+void Lsc::prepare([[maybe_unused]] IPAContext &context,
+		  [[maybe_unused]] const uint32_t frame,
+		  [[maybe_unused]] IPAFrameContext &frameContext,
+		  DebayerParams *params)
+{
+	params->lscK1 = k1_;
+	params->lscK2 = k2_;
+}
+
+REGISTER_IPA_ALGORITHM(Lsc, "Lsc")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
