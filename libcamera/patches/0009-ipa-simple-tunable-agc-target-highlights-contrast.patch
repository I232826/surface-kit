 	int32_t &exposure = frameContext.sensor.exposure;
@@ -146,10 +168,9 @@
 	}
 	framesWaited_ = 0;
 
-	const double hl = std::clamp((highlights - kHighlightsLow) /
-				     (kHighlightsHigh - kHighlightsLow), 0.0, 1.0);
