 }
 
+/*
+ * Tuning keys, all optional:
+ *   target: mean sample value to aim for (1..5, default 2.5)
+ *   highlightsLevel: Y (0..255) from which a pixel counts as a highlight
+ *   highlightsLow, highlightsHigh: share of highlight pixels over which the
+ *     target is lowered linearly ...
+ *   highlightsMinTarget: ... down to this
+ */
+int Agc::init([[maybe_unused]] IPAContext &context, const YamlObject &tuningData)
+{
+	target_ = tuningData["target"].get<double>(kExposureOptimal);
+	highlightsLow_ = tuningData["highlightsLow"].get<double>(0.01);
+	highlightsHigh_ = tuningData["highlightsHigh"].get<double>(0.05);
+	highlightsMinTarget_ = tuningData["highlightsMinTarget"].get<double>(2.0);
+	const unsigned int level =
+		std::clamp(tuningData["highlightsLevel"].get<unsigned int>(240), 0u, 255u);
+	highlightsBin_ = level * SwIspStats::kYHistogramSize / 256;
+
+	if (highlightsHigh_ <= highlightsLow_)
+		highlightsHigh_ = highlightsLow_ + 0.01;
+
+	return 0;
+}
+
 int Agc::configure([[maybe_unused]] IPAContext &context,
 		   [[maybe_unused]] const IPAConfigInfo &configInfo)
 {
@@ -103,8 +128,8 @@
  *
  * The mean alone lets a bright surface in a dim room burn out, so the
  * target is lowered as the share of near-clipped pixels grows, from
- * kExposureOptimal at kHighlightsLow down to kHighlightsMinTarget at
- * kHighlightsHigh. A gentle trade: hard limits on the highlights left
+ * target_ at highlightsLow_ down to highlightsMinTarget_ at
+ * highlightsHigh_ (see init() for the tuning keys). A gentle trade: hard limits on the highlights left
  * scenes with a little white in them far too dark.
  */
 void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
@@ -120,9 +145,6 @@
 	 * than libcamera's table says (gain delay 1 vs 2 made this oscillate).
