 namespace ipa::soft::algorithms {
 
+/*
+ * With a "locus" in the tuning file, the light's colour is read from the
+ * brightest unclipped pixels (white objects and reflections show the light
+ * itself) and snapped onto the sensor's grey locus: the R/G, B/G a neutral
+ * surface gives under daylight and tungsten light, warm to cool, e.g. from
+ * the module's calibration. Grey world, the fallback without a locus, is
+ * fooled by any scene dominated by one colour; on a teal-dominated scene
+ * under a 3100 K lamp it was 46% off, this 6% (Surface Pro 7 rear camera,
+ * white paper reference).
+ *
+ *   - Awb:
+ *       locus: [ [ 0.880, 0.363 ], [ 0.528, 0.572 ], ... ]   # R/G, B/G
+ *       brightFraction: 0.02   # share of pixels taken as the brightest
+ *       speed: 0.3             # 0..1, smoothing between estimates
+ */
+int Awb::init([[maybe_unused]] IPAContext &context, const YamlObject &tuningData)
+{
+	for (const auto &entry : tuningData["locus"].asList()) {
+		auto v = entry.getList<double>();
+		if (!v || v->size() != 2 || (*v)[0] <= 0 || (*v)[1] <= 0) {
+			LOG(IPASoftAwb, Error) << "Invalid locus point";
+			return -EINVAL;
+		}
+		locus_.push_back({ std::log2((*v)[0]), std::log2((*v)[1]) });
+	}
+	if (locus_.size() == 1) {
+		LOG(IPASoftAwb, Error) << "Locus needs at least two points";
+		return -EINVAL;
+	}
+	brightFraction_ = std::clamp(tuningData["brightFraction"].get<double>(0.02), 0.001, 1.0);
+	speed_ = std::clamp(tuningData["speed"].get<double>(0.3), 0.01, 1.0);
+
+	LOG(IPASoftAwb, Debug)
+		<< "locus with " << locus_.size() << " points, brightest "
+		<< brightFraction_ * 100 << "%";
+	return 0;
+}
+
 int Awb::configure(IPAContext &context,
 		   [[maybe_unused]] const IPAConfigInfo &configInfo)
 {
 	auto &gains = context.activeState.awb.gains;
 	gains = { { 1.0, 1.0, 1.0 } };
+	estimate_.reset();
 
 	return 0;
 }
