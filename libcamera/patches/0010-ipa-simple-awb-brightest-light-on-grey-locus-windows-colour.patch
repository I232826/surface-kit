+/* log2 chromaticity of the brightest brightFraction_ of unclipped pixels */
+std::optional<Awb::Point> Awb::brightestLight(const SwIspStats *stats,
+					      uint8_t blackLevel) const
+{
+	const uint64_t total = std::accumulate(stats->yBinCounts.begin(),
+					       stats->yBinCounts.end(), uint64_t(0));
+	const double want = std::max(total * brightFraction_, 16.0);
+	double r = 0, g = 0, b = 0, n = 0;
+
+	for (int bin = SwIspStats::kYHistogramSize - 1; bin >= 0 && n < want; bin--) {
+		const double count = stats->yBinCounts[bin];
+		if (!count)
+			continue;
+		/* take a share of the last bin, to land on the fraction */
+		const double share = std::min(1.0, (want - n) / count);
+		const RGB<uint64_t> &s = stats->yBinSums[bin];
+		r += share * (s.r() - blackLevel * count);
+		g += share * (s.g() - blackLevel * count);
+		b += share * (s.b() - blackLevel * count);
+		n += share * count;
+	}
+
+	/* too dark to tell: a few counts above black is noise */
+	if (n < 16 || g < n * 4 || r <= 0 || b <= 0)
+		return std::nullopt;
+
+	return Point{ std::log2(r / g), std::log2(b / g) };
+}
+
+/* nearest point on the locus polyline */
+Awb::Point Awb::projectOnLocus(const Point &p) const
+{
+	Point best = locus_.front();
+	double bestDist = INFINITY;
+
+	for (size_t i = 0; i + 1 < locus_.size(); i++) {
+		const Point &a = locus_[i], &c = locus_[i + 1];
+		const double dx = c[0] - a[0], dy = c[1] - a[1];
+		double t = ((p[0] - a[0]) * dx + (p[1] - a[1]) * dy) / (dx * dx + dy * dy);
+		t = std::clamp(t, 0.0, 1.0);
+		const Point q{ a[0] + t * dx, a[1] + t * dy };
+		const double d = std::hypot(p[0] - q[0], p[1] - q[1]);
+		if (d < bestDist) {
+			bestDist = d;
+			best = q;
+		}
+	}
+	return best;
+}
