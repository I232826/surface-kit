From: surface-kit
Subject: [PATCH] software_isp: statistics every frame; af: wait for stable exposure, flat sweeps

The rear camera runs at 15 fps in the full-resolution modes apps use, so
with statistics every 4th frame autofocus got 3.75 samples a second: about
4 s to sweep, ~2 s more before a refocus. Statistics now come every frame
(8% -> ~12% of one core at 1920x1080), and autofocus focuses in ~1.3 s
(2.7 s after the camera opens, was ~6.7 s).

Sampling every frame exposed two faults:
- the first sweep started while the exposure was still converging; the
  drifting measure looked like a peak passed near infinity and the sweep
  stopped there. Startup now also waits for contrast and brightness to be
  steady for stableFrames.
- a local sweep with a flat curve (no peak in it) counted as found, and
  refocusing then stayed stuck near the old position. A sweep whose best
  sample is not 15% above its worst now falls back to the full range.

Against a raw focus sweep (sharpest at 352-384), five runs ended at
357-376. Exposure still settles once and holds.

---
--- a/include/libcamera/internal/software_isp/swstats_cpu.h
+++ b/include/libcamera/internal/software_isp/swstats_cpu.h
@@ -43,7 +43,7 @@
 	 * Run stats once every 4 frames to ensure any previous
 	 * exposure changes have been applied.
 	 */
-	static constexpr uint32_t kStatPerNumFrames = 4;
+	static constexpr uint32_t kStatPerNumFrames = 1;
 
 	bool isValid() const { return sharedStats_.fd().isValid(); }
 
--- a/src/ipa/simple/algorithms/af.cpp
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -18,6 +18,9 @@
 
 LOG_DEFINE_CATEGORY(IPASoftAf)
 
+/* a sweep whose best sample isn't this much above its worst found no peak */
+static constexpr double kPeakContrast = 1.15;
+
 /**
  * \class Af
  * \brief Contrast detection autofocus driving the sensor's VCM lens
@@ -54,7 +57,7 @@
 	settleFrames_ = tuningData["settleFrames"].get<uint32_t>(5);
 	startupFrames_ = tuningData["startupFrames"].get<uint32_t>(36);
 	changeThreshold_ = tuningData["changeThreshold"].get<double>(0.35);
-	/* statistics come every 4th frame: 8 is about one second at 30 fps */
+	/* statistics come every frame: 8 is about half a second at 15 fps */
 	changeFrames_ = std::max(tuningData["changeFrames"].get<uint32_t>(8), 1u);
 	stableFrames_ = std::max(tuningData["stableFrames"].get<uint32_t>(3), 1u);
 	localRange_ = tuningData["localRange"].get<int32_t>(2);
@@ -165,15 +168,18 @@
 /*
  * Whether the best sample of the sweep has a lower sample on both sides,
  * or sits at the end of the lens range (where a wider sweep can't help).
+ * A flat sweep has no peak at all: the focus lies outside it.
  */
 bool Af::peakInside(const IPAContext &context) const
 {
-	auto best = std::max_element(samples_.begin(), samples_.end(),
-				     [](const auto &a, const auto &b) {
-					     return a.second < b.second;
-				     });
+	auto [low, best] = std::minmax_element(samples_.begin(), samples_.end(),
+					       [](const auto &a, const auto &b) {
+						       return a.second < b.second;
+					       });
 	if (best == samples_.end())
 		return true;
+	if (best->second < kPeakContrast * low->second)
+		return false;
 
 	const auto &cfg = context.configuration.af;
 	if (best == samples_.begin())
@@ -205,9 +211,22 @@
 
 	switch (state_) {
 	case State::Startup:
-		if (!startFrame_)
+		/*
+		 * Wait for the exposure to settle as well: while it converges
+		 * the measure drifts, and a sweep taking that for a peak passed
+		 * stops at once near infinity.
+		 */
+		if (!startFrame_) {
 			startFrame_ = frame ? frame : 1;
-		if (frame - startFrame_ >= startupFrames_)
+			stableCount_ = 0;
+		} else if (std::abs(level / lastLevel_ - 1.0) < 0.05 &&
+			   std::abs(score / lastScore_ - 1.0) < 0.1) {
+			stableCount_++;
+		} else {
+			stableCount_ = 0;
+		}
+		if (frame - startFrame_ >= startupFrames_ &&
+		    stableCount_ >= stableFrames_)
 			startScan(context, frame, context.configuration.af.lensMin,
 				  scanMax_, step_);
 		break;
@@ -236,7 +255,7 @@
 			const int32_t target = peak();
 			LOG(IPASoftAf, Debug) << "Peak at " << target;
 			if (localScan_ && !peakInside(context)) {
-				LOG(IPASoftAf, Debug) << "Peak at the edge, full sweep";
+				LOG(IPASoftAf, Debug) << "No peak inside, full sweep";
 				startScan(context, frame, context.configuration.af.lensMin,
 					  scanMax_, step_);
 				break;
--- a/src/ipa/simple/data/ov8865.yaml
+++ b/src/ipa/simple/data/ov8865.yaml
@@ -54,4 +54,5 @@
   # contrast autofocus on the dw9719 VCM
   - Af:
       settleFrames: 2
+      startupFrames: 15
 ...
