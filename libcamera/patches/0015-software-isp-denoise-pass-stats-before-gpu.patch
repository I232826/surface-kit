+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * denoise.frag - Edge-preserving noise reduction on the debayered image
+ *
+ * Second pass after the Bayer shader, on its gamma-encoded RGB. Luma is
+ * smoothed over 3x3 pixels with weights from luma similarity (sigma), so
+ * edges and texture survive. Chroma noise at high gain comes in clumps
+ * larger than that: chroma is averaged over 3x3 taps 4 pixels apart, with a
+ * 3x wider luma tolerance, so colour speckles go but colours don't bleed
+ * across edges.
+ */
+
+#ifdef GL_ES
+precision highp float;
+#endif
+
+uniform sampler2D tex_rgb;
+uniform vec2 texel;		/* 1 / texture size */
+uniform float sigma;		/* output noise, 0..1; 0: pass through */
+varying vec2 textureOut;
+
+float luma(vec3 c)
+{
+	return dot(c, vec3(0.299, 0.587, 0.114));
+}
+
+void main(void)
+{
+	vec3 c = texture2D(tex_rgb, textureOut).rgb;
+	vec3 rgb = c;
+
+	if (sigma > 0.0) {
+		float y = luma(c);
+		float kl = 0.5 / (sigma * sigma);
+		float kc = kl / 9.0;
+		float sumY = 0.0, wY = 0.0;
+		vec2 sumC = vec2(0.0);
+		float wC = 0.0;
+
+		/*
+		 * 3x3 taps each: luma at 1 pixel, chroma 4 pixels apart. A
+		 * rational falloff stands in for exp(-x); 18 reads per pixel
+		 * keep 3264x1836 at the sensor's 20 fps on the Ice Lake GPU.
+		 */
+		for (int dy = -1; dy <= 1; dy++) {
+			for (int dx = -1; dx <= 1; dx++) {
+				vec2 d = vec2(float(dx), float(dy));
+				float ws = 1.0 / (1.0 + 0.5 * dot(d, d));
+
+				float yn = luma(texture2D(tex_rgb, textureOut + d * texel).rgb);
+				float dl = yn - y;
+				float a = ws / (1.0 + kl * dl * dl * (1.0 + kl * dl * dl));
+				sumY += a * yn;
+				wY += a;
+
+				vec3 cn = texture2D(tex_rgb, textureOut + 4.0 * d * texel).rgb;
+				float yc = luma(cn);
+				float dc = yc - y;
+				float b = ws / (1.0 + kc * dc * dc * (1.0 + kc * dc * dc));
+				sumC += b * vec2(cn.b - yc, cn.r - yc);
+				wC += b;
+			}
+		}
+
+		float yo = sumY / wY;
+		vec2 co = sumC / wC;		/* (B - Y, R - Y) */
+		float r = yo + co.y;
+		float b = yo + co.x;
+		float g = (yo - 0.299 * r - 0.114 * b) / 0.587;
+		rgb = clamp(vec3(r, g, b), 0.0, 1.0);
+	}
+
+#if defined(SWAP_BLUE)
+	gl_FragColor = vec4(rgb.bgr, 1.0);
+#else
+	gl_FragColor = vec4(rgb, 1.0);
+#endif
+}
