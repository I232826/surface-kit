+int DebayerEGL::initDenoiseShaders()
+{
+	std::vector<std::string> shaderEnv;
+	GLuint vertexShaderId, fragmentShaderId;
+
+	egl_.pushEnv(shaderEnv, "#version 100");
+	if (swapBlue_)
+		egl_.pushEnv(shaderEnv, "#define SWAP_BLUE");
+
+	if (egl_.compileVertexShader(vertexShaderId, identity_vert, identity_vert_len, shaderEnv)) {
+		LOG(Debayer, Error) << "Compile denoise vertex shader fail";
+		return -ENODEV;
+	}
+	utils::scope_exit vShaderGuard([&] { glDeleteShader(vertexShaderId); });
+
+	if (egl_.compileFragmentShader(fragmentShaderId, denoise_frag, denoise_frag_len, shaderEnv)) {
+		LOG(Debayer, Error) << "Compile denoise fragment shader fail";
+		return -ENODEV;
+	}
+	utils::scope_exit fShaderGuard([&] { glDeleteShader(fragmentShaderId); });
+
+	if (egl_.linkProgram(denoiseProgramId_, vertexShaderId, fragmentShaderId)) {
+		LOG(Debayer, Error) << "Linking denoise program fail";
+		return -ENODEV;
+	}
+
+	denoiseAttributeVertex_ = glGetAttribLocation(denoiseProgramId_, "vertexIn");
+	denoiseAttributeTexture_ = glGetAttribLocation(denoiseProgramId_, "textureIn");
+	denoiseUniformTexture_ = glGetUniformLocation(denoiseProgramId_, "tex_rgb");
+	denoiseUniformTexel_ = glGetUniformLocation(denoiseProgramId_, "texel");
+	denoiseUniformSigma_ = glGetUniformLocation(denoiseProgramId_, "sigma");
+	denoiseUniformProjMatrix_ = glGetUniformLocation(denoiseProgramId_, "proj_matrix");
+	denoiseUniformStrideFactor_ = glGetUniformLocation(denoiseProgramId_, "stride_factor");
+
 	return 0;
 }
 
 void DebayerEGL::stop()
 {
+	eglImageRGB_.reset();
 	eglImageBayerOut_.reset();
 	eglImageBayerIn_.reset();
 
+	if (denoiseProgramId_)
+		glDeleteProgram(denoiseProgramId_);
+	denoiseProgramId_ = 0;
 	if (programId_)
 		glDeleteProgram(programId_);
 }
