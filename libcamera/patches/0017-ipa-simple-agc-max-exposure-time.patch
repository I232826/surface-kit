From: surface-kit
Subject: [PATCH] ipa: simple: agc: tunable longest exposure time

At 20 fps the ov8865 allows 50 ms frames, and in a dim room the AGC used
them: handheld, sheet music came out smeared. maxExposureTime (us, 0:
the sensor's limit) caps the exposure; gain and the denoise pass make up
the difference. ov8865: 33333 (30 ms after anti-flicker rounding).

---
--- a/src/ipa/simple/algorithms/agc.h
+++ b/src/ipa/simple/algorithms/agc.h
@@ -41,6 +41,7 @@
 	unsigned int highlightsBin_;
 	/* Total exposure last requested (lines at unity gain), 0 = none */
 	double requestedTotal_;
+	double maxExposureTime_;
 	unsigned int framesWaited_;
 	unsigned int framesApplied_;
 };
--- a/src/ipa/simple/algorithms/agc.cpp
+++ b/src/ipa/simple/algorithms/agc.cpp
@@ -97,6 +97,12 @@
 	highlightsLow_ = tuningData["highlightsLow"].get<double>(0.01);
 	highlightsHigh_ = tuningData["highlightsHigh"].get<double>(0.05);
 	highlightsMinTarget_ = tuningData["highlightsMinTarget"].get<double>(2.0);
+	/*
+	 * Longest exposure, in microseconds (0: the sensor's limit). Held in
+	 * the hand, a frame much longer than ~1/30 s smears fine detail; gain
+	 * and the denoise pass are the better trade.
+	 */
+	maxExposureTime_ = tuningData["maxExposureTime"].get<double>(0.0);
 	const unsigned int level =
 		std::clamp(tuningData["highlightsLevel"].get<unsigned int>(240), 0u, 255u);
 	highlightsBin_ = level * SwIspStats::kYHistogramSize / 256;
@@ -107,9 +113,15 @@
 	return 0;
 }
 
-int Agc::configure([[maybe_unused]] IPAContext &context,
+int Agc::configure(IPAContext &context,
 		   [[maybe_unused]] const IPAConfigInfo &configInfo)
 {
+	auto &cfg = context.configuration.agc;
+	const double line = cfg.lineDuration.get<std::micro>();
+	if (maxExposureTime_ > 0.0 && line > 0.0)
+		cfg.exposureMax = std::clamp(static_cast<int32_t>(maxExposureTime_ / line),
+					     cfg.exposureMin, cfg.exposureMax);
+
 	requestedTotal_ = 0.0;
 	framesWaited_ = 0;
 	framesApplied_ = 0;
--- a/src/ipa/simple/data/ov8865.yaml
+++ b/src/ipa/simple/data/ov8865.yaml
@@ -47,6 +47,8 @@
   # gives real blacks without the washed-out look of the old 2.2 / 1.0.
   - Agc:
       target: 1.6
+      # 1/30 s: longer frames (up to 50 ms at 20 fps) smear handheld shots
+      maxExposureTime: 33333
       highlightsLevel: 224
       highlightsLow: 0.005
       highlightsHigh: 0.03
