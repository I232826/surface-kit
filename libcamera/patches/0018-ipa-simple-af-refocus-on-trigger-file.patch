+/*
+ * Apps can ask for a fresh sweep (a focus button, a tap on the picture) by
+ * changing the time stamp of $XDG_RUNTIME_DIR/libcamera-af-trigger: the
+ * picture often reaches them through PipeWire, which doesn't pass
+ * controls::AfTrigger on. Checked every few frames; one stat() call.
+ */
+static int64_t fileStamp(const std::string &path)
+{
+	struct stat st;
+	if (path.empty() || stat(path.c_str(), &st))
+		return 0;
+	return static_cast<int64_t>(st.st_mtim.tv_sec) * 1000000000 + st.st_mtim.tv_nsec;
+}
+
+bool Af::triggered(uint32_t frame)
+{
+	if (frame - triggerChecked_ < 5)
+		return false;
+	triggerChecked_ = frame;
+	const int64_t stamp = fileStamp(triggerPath_);
+	if (stamp == triggerStamp_)
+		return false;
+	triggerStamp_ = stamp;
+	return true;
+}
+
 int Af::configure(IPAContext &context,
 		  [[maybe_unused]] const IPAConfigInfo &configInfo)
 {
+	const char *runtime = std::getenv("XDG_RUNTIME_DIR");
+	triggerPath_ = runtime ? std::string(runtime) + "/libcamera-af-trigger" : "";
+	triggerStamp_ = fileStamp(triggerPath_);
+	triggerChecked_ = 0;
+
 	state_ = State::Startup;
 	startFrame_ = 0;
 	moves_.clear();
@@ -220,6 +254,15 @@
 	const double level = static_cast<double>(stats->afLevel);
 	const double score = stats->afContrast / level;
 
