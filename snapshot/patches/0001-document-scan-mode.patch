+    /// Asks the camera's autofocus for a fresh sweep. The picture reaches
+    /// us through PipeWire, which has no way to pass libcamera's AfTrigger
+    /// on; the surface-kit libcamera build watches the time stamp of
+    /// $XDG_RUNTIME_DIR/libcamera-af-trigger instead.
+    pub fn trigger_autofocus(&self) {
+        let path = glib::user_runtime_dir().join("libcamera-af-trigger");
+        // new contents, so the time stamp changes even within a second
+        let now = glib::real_time().to_string();
+        if let Err(err) = std::fs::write(&path, now) {
+            log::warn!("Could not trigger autofocus via {}: {err}", path.display());
+        }
+    }
