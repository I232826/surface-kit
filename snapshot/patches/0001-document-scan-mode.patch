+    /// Picks the stream format for what is being captured (see
+    /// [`crate::StreamResolution`]). Restarts a running stream with it.
+    pub fn set_resolution(&self, resolution: crate::StreamResolution) {
+        if !crate::utils::caps::set_resolution(resolution) {
+            return;
+        }
+
+        let imp = self.imp();
+        let (Some(camera), Some(capsfilter)) = (self.camera(), imp.capsfilter.get()) else {
+            return;
+        };
+        // Decide by the setting, not by comparing caps: other mode changes
+        // can have put the new caps on the filter already, but only a
+        // restart makes the running stream take them.
+        let caps = camera.best_caps();
+        // Not only Playing: while previewing camerabin can report Paused
+        // (or sit in a locked state), and the new format must still apply.
+        let running = !matches!(imp.camerabin().current_state(), gst::State::Null);
+        log::debug!("Stream resolution {resolution:?}, restarting the stream: {running}");
+        if running {
+            self.stop_stream();
+        }
+        capsfilter.set_property("caps", &caps);
+        if running {
+            self.start_stream();
+        }
+    }
