+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Dialog to adjust a document scan before saving: the photo with the page
+//! outline found in it and a handle on each corner to drag (with a
+//! magnifier while dragging), buttons to turn the page, a black and white
+//! switch, and "Add Page" to collect pages for a PDF.
+
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+
+use adw::prelude::*;
+use gettextrs::gettext;
+use gtk::{cairo, gio, glib};
+
+use crate::config;
+use crate::document::{Point, Prepared, ScanOptions};
+
+/// Touch-friendly distance (in widget pixels) at which a handle is grabbed.
+const GRAB_RADIUS: f64 = 40.0;
+const HANDLE_RADIUS: f64 = 11.0;
+/// Magnifier shown while dragging a corner.
+const LOUPE_RADIUS: f64 = 70.0;
+const LOUPE_ZOOM: f64 = 3.0;
+const ACCENT: (f64, f64, f64) = (0.21, 0.52, 0.89);
+
+thread_local! {
+    /// Pages are often shot the same way round: keep the last rotation.
+    static LAST_TURNS: Cell<u8> = const { Cell::new(0) };
+}
+
+/// What the user chose in the dialog.
+pub struct Choice {
+    pub corners: [Point; 4],
+    pub options: ScanOptions,
+    /// Keep the page for a PDF and shoot the next one, instead of finishing.
+    pub add_page: bool,
+}
+
+/// Maps between photo pixels and widget pixels for the current size.
+#[derive(Clone, Copy)]
+struct Fit {
+    scale: f64,
+    x0: f64,
+    y0: f64,
+}
+
+impl Fit {
+    fn new(photo_w: f64, photo_h: f64, area_w: f64, area_h: f64) -> Self {
+        let margin = HANDLE_RADIUS + 4.0;
+        let scale = ((area_w - 2.0 * margin) / photo_w)
+            .min((area_h - 2.0 * margin) / photo_h)
+            .max(0.01);
+        Self {
+            scale,
+            x0: (area_w - photo_w * scale) / 2.0,
+            y0: (area_h - photo_h * scale) / 2.0,
+        }
+    }
+
+    fn to_widget(self, p: Point) -> Point {
+        (self.x0 + p.0 * self.scale, self.y0 + p.1 * self.scale)
+    }
+
+    fn to_photo(self, p: Point) -> Point {
+        ((p.0 - self.x0) / self.scale, (p.1 - self.y0) / self.scale)
+    }
+}
+
+/// Everything the drawing needs.
+struct View {
+    surface: cairo::ImageSurface,
+    preview_scale: f64, // photo pixels per preview pixel
+    photo_w: f64,
+    photo_h: f64,
+    corners: RefCell<[Point; 4]>,
+    turns: Cell<u8>,
+    dragging: Cell<Option<usize>>,
+}
+
+/// Shows the dialog over `window`. `page` is the number this page gets in
+/// the PDF being collected (1 when none is). Returns `None` if the user
+/// cancelled.
+pub async fn adjust(window: &crate::Window, prep: &Prepared, page: usize) -> Option<Choice> {
+    let settings = gio::Settings::new(config::APP_ID);
+    let surface = {
+        let p = &prep.preview;
+        cairo::ImageSurface::create_for_data(
+            p.argb.clone(),
+            cairo::Format::ARgb32,
+            p.width as i32,
+            p.height as i32,
+            (p.width * 4) as i32,
+        )
+        .ok()?
+    };
+    let view = Rc::new(View {
+        surface,
+        preview_scale: prep.width as f64 / prep.preview.width as f64,
+        photo_w: prep.width as f64,
+        photo_h: prep.height as f64,
+        corners: RefCell::new(prep.corners),
+        turns: Cell::new(LAST_TURNS.get()),
+        dragging: Cell::new(None),
+    });
+
+    let area = gtk::DrawingArea::builder()
+        .hexpand(true)
+        .vexpand(true)
+        .content_width(640)
+        .content_height(480)
+        .build();
+    area.set_draw_func(glib::clone!(
+        #[strong]
+        view,
+        move |_, cr, w, h| draw(cr, &view, w as f64, h as f64)
+    ));
+
+    // Drag the handle nearest to where the drag starts.
+    let start: Rc<Cell<Point>> = Rc::default();
+    let drag = gtk::GestureDrag::new();
+    drag.connect_drag_begin(glib::clone!(
+        #[strong]
+        view,
+        #[strong]
+        start,
+        move |gesture, x, y| {
+            let area = gesture.widget().unwrap();
+            let fit = Fit::new(view.photo_w, view.photo_h, area.width() as f64, area.height() as f64);
+            let nearest = view
+                .corners
+                .borrow()
+                .iter()
+                .map(|&c| fit.to_widget(c))
+                .enumerate()
+                .map(|(i, (cx, cy))| (i, ((cx - x).powi(2) + (cy - y).powi(2)).sqrt()))
+                .min_by(|a, b| a.1.total_cmp(&b.1));
+            match nearest {
+                Some((i, d)) if d <= GRAB_RADIUS => {
+                    view.dragging.set(Some(i));
+                    start.set(fit.to_widget(view.corners.borrow()[i]));
+                    gesture.set_state(gtk::EventSequenceState::Claimed);
+                    area.queue_draw();
+                }
+                _ => {
+                    view.dragging.set(None);
+                    gesture.set_state(gtk::EventSequenceState::Denied);
+                }
+            }
+        }
+    ));
+    drag.connect_drag_update(glib::clone!(
+        #[strong]
+        view,
+        #[strong]
+        start,
+        move |gesture, dx, dy| {
+            let Some(i) = view.dragging.get() else {
+                return;
+            };
+            let area = gesture.widget().unwrap();
+            let fit = Fit::new(view.photo_w, view.photo_h, area.width() as f64, area.height() as f64);
+            let s = start.get();
+            let (x, y) = fit.to_photo((s.0 + dx, s.1 + dy));
+            view.corners.borrow_mut()[i] =
+                (x.clamp(0.0, view.photo_w - 1.0), y.clamp(0.0, view.photo_h - 1.0));
+            area.queue_draw();
+        }
+    ));
+    drag.connect_drag_end(glib::clone!(
+        #[strong]
+        view,
+        move |gesture, _, _| {
+            view.dragging.set(None);
+            if let Some(area) = gesture.widget() {
+                area.queue_draw();
+            }
+        }
+    ));
+    area.add_controller(drag);
+
+    // Bottom bar: turn the page, black and white.
+    let turn_left = gtk::Button::builder()
+        .icon_name("object-rotate-left-symbolic")
+        .tooltip_text(gettext("Turn Left"))
+        .css_classes(["circular"])
+        .build();
+    let turn_right = gtk::Button::builder()
+        .icon_name("object-rotate-right-symbolic")
+        .tooltip_text(gettext("Turn Right"))
+        .css_classes(["circular"])
+        .build();
+    for (button, step) in [(&turn_left, 3u8), (&turn_right, 1u8)] {
+        button.connect_clicked(glib::clone!(
+            #[strong]
+            view,
+            #[weak]
+            area,
+            move |_| {
+                view.turns.set((view.turns.get() + step) % 4);
+                area.queue_draw();
+            }
+        ));
+    }
+    let bw_switch = gtk::Switch::builder()
+        .valign(gtk::Align::Center)
+        .active(settings.boolean("document-black-white"))
+        .build();
+    let bw_label = gtk::Label::new(Some(&gettext("Black & White")));
+    let bar = gtk::Box::builder()
+        .orientation(gtk::Orientation::Horizontal)
+        .spacing(12)
+        .margin_top(6)
+        .margin_bottom(12)
+        .margin_start(12)
+        .margin_end(12)
+        .build();
+    let hint = gtk::Label::builder()
+        .label(if prep.detected {
+            gettext("Drag the corners onto the page’s corners. The arrow marks the top.")
+        } else {
+            gettext("No page found: drag the corners onto the page’s corners")
+        })
+        .wrap(true)
+        .hexpand(true)
+        .xalign(0.0)
+        .css_classes(["dim-label"])
+        .build();
+    bar.append(&turn_left);
+    bar.append(&turn_right);
+    bar.append(&hint);
+    bar.append(&bw_label);
+    bar.append(&bw_switch);
+
+    let (sender, receiver) = futures_channel::oneshot::channel::<Option<Choice>>();
+    let sender = Rc::new(RefCell::new(Some(sender)));
+
+    let cancel = gtk::Button::with_label(&gettext("Cancel"));
+    let add = gtk::Button::builder()
+        .label(gettext("Add Page"))
+        .tooltip_text(gettext("Keep this page for a PDF and scan the next one"))
+        .build();
+    let save = gtk::Button::builder()
+        .label(if page > 1 { gettext("Save PDF") } else { gettext("Save Scan") })
+        .css_classes(["suggested-action"])
+        .build();
+    let header = adw::HeaderBar::builder()
+        .show_start_title_buttons(false)
+        .show_end_title_buttons(false)
+        .build();
+    header.pack_start(&cancel);
+    header.pack_end(&save);
+    header.pack_end(&add);
+
+    let content = gtk::Box::new(gtk::Orientation::Vertical, 0);
+    content.append(&area);
+    content.append(&bar);
+
+    let toolbar = adw::ToolbarView::new();
+    toolbar.add_top_bar(&header);
+    toolbar.set_content(Some(&content));
+
+    let title = if page > 1 {
+        // TRANSLATORS {page} is the page number in the PDF being collected
+        gettext("Adjust Page {page}").replace("{page}", &page.to_string())
+    } else {
+        gettext("Adjust Page")
+    };
+    let dialog = adw::Dialog::builder()
+        .title(title)
+        .content_width(900)
+        .content_height(720)
+        .child(&toolbar)
+        .build();
+
+    let finish = {
+        let sender = sender.clone();
+        move |choice: Option<Choice>| {
+            if let Some(sender) = sender.borrow_mut().take() {
+                let _ = sender.send(choice);
+            }
+        }
+    };
+    cancel.connect_clicked(glib::clone!(
+        #[weak]
+        dialog,
+        move |_| {
+            dialog.close();
+        }
+    ));
+    for (button, add_page) in [(&save, false), (&add, true)] {
+        button.connect_clicked(glib::clone!(
+            #[weak]
+            dialog,
+            #[weak]
+            bw_switch,
+            #[strong]
+            view,
+            #[strong]
+            settings,
+            #[strong]
+            finish,
+            move |_| {
+                let black_white = bw_switch.is_active();
+                let _ = settings.set_boolean("document-black-white", black_white);
+                LAST_TURNS.set(view.turns.get());
+                finish(Some(Choice {
+                    corners: *view.corners.borrow(),
+                    options: ScanOptions {
+                        quarter_turns: view.turns.get(),
+                        black_white,
+                    },
+                    add_page,
+                }));
+                dialog.close();
+            }
+        ));
+    }
+    dialog.connect_closed(move |_| finish(None));
+
+    dialog.present(Some(window));
+    receiver.await.ok().flatten()
+}
+
+fn quad_path(cr: &cairo::Context, w: &[Point]) {
+    cr.move_to(w[0].0, w[0].1);
+    for p in &w[1..] {
+        cr.line_to(p.0, p.1);
+    }
+    cr.close_path();
+}
+
+fn paint_photo(cr: &cairo::Context, view: &View, fit: Fit) {
+    cr.save().ok();
+    cr.translate(fit.x0, fit.y0);
+    cr.scale(fit.scale * view.preview_scale, fit.scale * view.preview_scale);
+    cr.set_source_surface(&view.surface, 0.0, 0.0).ok();
+    cr.source().set_filter(cairo::Filter::Good);
+    cr.paint().ok();
+    cr.restore().ok();
+}
+
+fn draw(cr: &cairo::Context, view: &View, aw: f64, ah: f64) {
+    let fit = Fit::new(view.photo_w, view.photo_h, aw, ah);
+    let c = *view.corners.borrow();
+    let w: Vec<Point> = c.iter().map(|&p| fit.to_widget(p)).collect();
+    let (r, g, b) = ACCENT;
+
+    paint_photo(cr, view, fit);
+
+    // shade what will be cut away
+    let (x1, y1) = fit.to_widget((0.0, 0.0));
+    let (x2, y2) = fit.to_widget((view.photo_w, view.photo_h));
+    cr.set_fill_rule(cairo::FillRule::EvenOdd);
+    cr.rectangle(x1, y1, x2 - x1, y2 - y1);
+    quad_path(cr, &w);
+    cr.set_source_rgba(0.0, 0.0, 0.0, 0.45);
+    cr.fill().ok();
+    cr.set_fill_rule(cairo::FillRule::Winding);
+
+    // outline
+    quad_path(cr, &w);
+    cr.set_line_width(2.5);
+    cr.set_source_rgb(r, g, b);
+    cr.stroke().ok();
+
+    // the side that becomes the top of the scan: an arrow pointing out of
+    // the page from its middle (turns clockwise move the top to the left
+    // side, the bottom, the right side)
+    let edge = [(0, 1), (3, 0), (2, 3), (1, 2)][view.turns.get() as usize % 4];
+    let (a, e) = (w[edge.0], w[edge.1]);
+    let mid = ((a.0 + e.0) / 2.0, (a.1 + e.1) / 2.0);
+    let centre = (
+        w.iter().map(|p| p.0).sum::<f64>() / 4.0,
+        w.iter().map(|p| p.1).sum::<f64>() / 4.0,
+    );
+    let (ox, oy) = (mid.0 - centre.0, mid.1 - centre.1);
+    let len = (ox * ox + oy * oy).sqrt().max(1.0);
+    let (ux, uy) = (ox / len, oy / len); // out of the page
+    let (px, py) = (-uy, ux);
+    let tip = (mid.0 - ux * 6.0, mid.1 - uy * 6.0);
+    let base = (mid.0 - ux * 30.0, mid.1 - uy * 30.0);
+    cr.move_to(tip.0, tip.1);
+    cr.line_to(base.0 + px * 14.0, base.1 + py * 14.0);
+    cr.line_to(base.0 - px * 14.0, base.1 - py * 14.0);
+    cr.close_path();
+    cr.set_source_rgb(r, g, b);
+    cr.fill_preserve().ok();
+    cr.set_source_rgb(1.0, 1.0, 1.0);
+    cr.set_line_width(2.0);
+    cr.stroke().ok();
+
+    // handles
+    for (i, p) in w.iter().enumerate() {
+        let grabbed = view.dragging.get() == Some(i);
+        cr.arc(p.0, p.1, if grabbed { HANDLE_RADIUS + 4.0 } else { HANDLE_RADIUS }, 0.0, std::f64::consts::TAU);
+        cr.set_source_rgb(1.0, 1.0, 1.0);
+        cr.fill_preserve().ok();
+        cr.set_line_width(3.0);
+        cr.set_source_rgb(r, g, b);
+        cr.stroke().ok();
+    }
+
+    // magnifier over the corner being dragged, set off from it so the
+    // finger doesn't cover it
+    if let Some(i) = view.dragging.get() {
+        let p = w[i];
+        let off = LOUPE_RADIUS + 30.0;
+        let lx = if p.0 - off - LOUPE_RADIUS < 0.0 { p.0 + off } else { p.0 - off };
+        let ly = if p.1 - off - LOUPE_RADIUS < 0.0 { p.1 + off } else { p.1 - off };
+        cr.save().ok();
+        cr.arc(lx, ly, LOUPE_RADIUS, 0.0, std::f64::consts::TAU);
+        cr.clip();
+        cr.set_source_rgb(0.1, 0.1, 0.1);
+        cr.paint().ok();
+        cr.translate(lx, ly);
+        cr.scale(LOUPE_ZOOM, LOUPE_ZOOM);
+        cr.translate(-p.0, -p.1);
+        paint_photo(cr, view, fit);
+        quad_path(cr, &w);
+        cr.set_source_rgb(r, g, b);
+        cr.set_line_width(1.5 / LOUPE_ZOOM);
+        cr.stroke().ok();
+        cr.restore().ok();
+        // crosshair and rim
+        cr.set_source_rgb(r, g, b);
+        cr.set_line_width(1.5);
+        cr.move_to(lx - 10.0, ly);
+        cr.line_to(lx + 10.0, ly);
+        cr.move_to(lx, ly - 10.0);
+        cr.line_to(lx, ly + 10.0);
+        cr.stroke().ok();
+        cr.arc(lx, ly, LOUPE_RADIUS, 0.0, std::f64::consts::TAU);
+        cr.set_source_rgb(1.0, 1.0, 1.0);
+        cr.set_line_width(3.0);
+        cr.stroke().ok();
+    }
+}
