+    /// Turns a photo just taken in document mode into a scan of the page:
+    /// finds the page off the main thread, lets the user adjust it and saves
+    /// the scan next to the photo, which stays. Pages added with "Add Page"
+    /// are collected, and the next page saved normally finishes them into
+    /// one PDF.
+    fn scan_document(&self, gallery: &crate::Gallery, window: &crate::Window, photo: std::path::PathBuf) {
+        glib::spawn_future_local(glib::clone!(
+            #[weak]
+            gallery,
+            #[weak]
+            window,
+            async move {
+                gallery.add_image(&gio::File::for_path(&photo));
+
+                let input = photo.clone();
+                let prep = match gio::spawn_blocking(move || crate::document::prepare(&input)).await {
+                    Ok(Ok(prep)) => prep,
+                    Ok(Err(err)) => {
+                        log::error!("Could not open {} for scanning: {err}", photo.display());
+                        window.send_toast(&gettext("Could not scan the page"));
+                        return;
+                    }
+                    Err(_) => {
+                        log::error!("Document scan thread panicked");
+                        return;
+                    }
+                };
+
+                let page = PDF_PAGES.with_borrow(|pages| pages.len()) + 1;
+                let Some(choice) = crate::scan_adjust::adjust(&window, &prep, page).await else {
+                    return;
+                };
+
+                let out = crate::document::scan_path(&photo);
+                let target = out.clone();
+                let saved = gio::spawn_blocking(move || {
+                    crate::document::save_scan(&prep, &choice.corners, choice.options, &target)
+                })
+                .await;
+                match saved {
+                    Ok(Ok(())) => gallery.add_image(&gio::File::for_path(&out)),
+                    Ok(Err(err)) => {
+                        log::error!("Could not save {}: {err}", out.display());
+                        window.send_toast(&gettext("Could not save the scan"));
+                        return;
+                    }
+                    Err(_) => {
+                        log::error!("Document scan thread panicked");
+                        return;
+                    }
+                }
+
+                if choice.add_page {
+                    PDF_PAGES.with_borrow_mut(|pages| pages.push(out));
+                    // TRANSLATORS {page} is the number of pages collected
+                    window.send_toast(
+                        &gettext("Page {page} added: scan the next one").replace("{page}", &page.to_string()),
+                    );
+                    return;
+                }
+                let pages = PDF_PAGES.with_borrow_mut(std::mem::take);
+                if pages.is_empty() {
+                    return;
+                }
+                let mut pages = pages;
+                pages.push(out.clone());
+                let pdf = out.with_extension("pdf");
+                let target = pdf.clone();
+                let count = pages.len();
+                match gio::spawn_blocking(move || crate::document::write_pdf(&pages, &target)).await {
+                    Ok(Ok(())) => {
+                        let toast = adw::Toast::builder()
+                            // TRANSLATORS {count} is the number of pages in the PDF
+                            .title(gettext("Saved a PDF of {count} pages").replace("{count}", &count.to_string()))
+                            .button_label(gettext("Open"))
+                            .build();
+                        toast.connect_button_clicked(glib::clone!(
+                            #[weak]
+                            window,
+                            move |_| {
+                                gtk::FileLauncher::new(Some(&gio::File::for_path(&pdf))).launch(
+                                    Some(&window),
+                                    None::<&gio::Cancellable>,
+                                    |result| {
+                                        if let Err(err) = result {
+                                            log::error!("Could not open the PDF: {err}");
+                                        }
+                                    },
+                                );
+                            }
+                        ));
+                        window.add_toast(toast);
+                    }
+                    Ok(Err(err)) => {
+                        log::error!("Could not write {}: {err}", pdf.display());
+                        window.send_toast(&gettext("Could not save the PDF"));
+                    }
+                    Err(_) => log::error!("PDF thread panicked"),
+                }
+            }
+        ));
+    }
